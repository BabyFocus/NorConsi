
:root{--bg:#071421;--ink:#e8f1f8;--muted:#a8bdcd;--line:rgba(255,255,255,.14);--accent:#00a0a0;--accent2:#4bb3fd;--warm:#ffb84d;--ok:#28d39a;--bad:#ff7b72;--radius:24px;font-family:Inter,Segoe UI,Arial,sans-serif}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0%,#123a56 0%,var(--bg) 35%,#050c14 100%);color:var(--ink);line-height:1.5}a{color:inherit;text-decoration:none}.site-header{position:sticky;top:0;background:rgba(7,20,33,.84);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);z-index:10}.nav{max-width:1220px;margin:auto;padding:16px 22px;display:flex;justify-content:space-between;gap:18px}.brand{font-weight:800}.nav-links{display:flex;gap:14px;color:var(--muted);font-size:14px}.hero,.section,.roadmap-wrap{max-width:1220px;margin:auto;padding:58px 22px}.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:36px}.eyebrow{color:var(--accent2);font-weight:800;text-transform:uppercase;letter-spacing:.14em;font-size:13px}h1{font-size:clamp(40px,6vw,72px);line-height:.98;letter-spacing:-.05em;margin:14px 0}h2{font-size:34px;margin:0 0 14px}h3{margin-top:0}.hero p,.muted{color:var(--muted);font-size:19px}.button{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:13px 18px;margin:8px 8px 0 0;background:rgba(255,255,255,.06);font-weight:700}.primary{background:linear-gradient(135deg,var(--accent),#0e7cc3);border:0}.card,.info-card,.phase-card{background:linear-gradient(180deg,rgba(255,255,255,.09),rgba(255,255,255,.035));border:1px solid var(--line);border-radius:var(--radius);padding:24px}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px}.metric{background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:16px;padding:15px}.metric strong{display:block;font-size:26px}.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.tag,.score,.pill{display:inline-block;border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:4px 10px;font-size:12px;color:#d8edf8;background:rgba(255,255,255,.06);margin-bottom:8px}.score{color:#d8fff2;background:rgba(40,211,154,.08);border-color:rgba(40,211,154,.22)}.page-hero{text-align:center;max-width:980px;margin:auto;padding:70px 22px 30px}.page-hero p{color:var(--muted);font-size:19px}.phase{display:grid;grid-template-columns:190px 1fr;gap:24px;border-top:1px solid var(--line);padding:26px 0}.phase-meta{color:var(--muted)}.phase-kicker{color:var(--accent2);font-weight:850;text-transform:uppercase;letter-spacing:.12em}.phase-button{width:100%;background:transparent;color:inherit;border:0;text-align:left;cursor:pointer;display:flex;justify-content:space-between;gap:20px}.phase-button h3{font-size:27px;margin:0 0 8px}.chev{font-size:26px;color:var(--accent2)}.phase-panel{display:none;border-top:1px solid var(--line);margin-top:18px;padding-top:18px}.phase.open .phase-panel{display:block}.phase-outcome{background:rgba(0,160,160,.10);border:1px solid rgba(0,160,160,.25);border-radius:16px;padding:13px;margin-bottom:18px}.timeline{border-left:2px solid var(--accent2);padding-left:22px}.timeline-item{margin-bottom:16px}.timeline-card{background:rgba(0,0,0,.18);border:1px solid var(--line);border-radius:18px;overflow:hidden}.timeline-trigger{width:100%;background:transparent;color:inherit;border:0;text-align:left;cursor:pointer;padding:16px;display:grid;grid-template-columns:110px 1fr auto;gap:14px}.date{color:var(--warm);font-weight:850}.detail{display:none;color:var(--muted);padding:0 16px 16px 140px}.active .detail{display:block}.success{margin-top:12px;padding:12px;border-radius:14px;background:rgba(40,211,154,.08);border:1px solid rgba(40,211,154,.22);color:#d8fff2}.table{width:100%;border-collapse:collapse;margin:12px 0 28px}.table th,.table td{padding:12px 13px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}.table th{background:rgba(255,255,255,.08)}li{color:var(--muted);margin-bottom:4px}.footer{border-top:1px solid var(--line);color:var(--muted);padding:32px;text-align:center}.warning{border-left:4px solid var(--warm)}.recommended{border-left:4px solid var(--accent)}.bad{color:var(--bad)}.good{color:#d8fff2}.flow{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.flow div{border:1px solid var(--line);border-radius:16px;padding:14px;background:rgba(255,255,255,.05)}.alt-card{margin-bottom:18px}.alt-card h3{font-size:26px}.small{font-size:14px;color:var(--muted)}@media(max-width:950px){.hero,.grid-4,.grid-3,.grid-2,.phase,.flow{grid-template-columns:1fr}.nav-links{display:none}.detail{padding:0 16px 16px}.timeline-trigger{grid-template-columns:1fr}.table{font-size:14px}}
