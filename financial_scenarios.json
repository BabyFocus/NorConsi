
:root{--bg:#071421;--ink:#e8f1f8;--muted:#a8bdcd;--line:rgba(255,255,255,.14);--accent:#00a0a0;--accent2:#4bb3fd;--warm:#ffb84d;--ok:#28d39a;--bad:#ff7b72;--radius:22px;font-family:Inter,Segoe UI,Arial,sans-serif}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0%,#123a56 0%,var(--bg) 35%,#050c14 100%);color:var(--ink);line-height:1.55}a{color:#d8f4ff;text-decoration:none}.site-header{position:sticky;top:0;background:rgba(7,20,33,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);z-index:10}.nav{max-width:1380px;margin:auto;padding:14px 22px;display:flex;justify-content:space-between;gap:18px}.brand{font-weight:800;white-space:nowrap}.nav-links{display:flex;gap:11px;color:var(--muted);font-size:13.5px;flex-wrap:wrap;justify-content:flex-end}.hero,.section{max-width:1320px;margin:auto;padding:52px 22px}.hero{display:grid;grid-template-columns:1.08fr .92fr;gap:36px}.page-hero{text-align:center;max-width:1080px;margin:auto;padding:66px 22px 28px}.eyebrow{color:var(--accent2);font-weight:800;text-transform:uppercase;letter-spacing:.14em;font-size:13px}h1{font-size:clamp(36px,5.2vw,64px);line-height:1.03;letter-spacing:-.04em;margin:14px 0}h2{font-size:31px;margin:0 0 14px}h3{margin-top:0}.hero p,.muted,.page-hero p{color:var(--muted);font-size:18px}.button{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:12px 17px;margin:8px 8px 0 0;background:rgba(255,255,255,.06);font-weight:700}.primary{background:linear-gradient(135deg,var(--accent),#0e7cc3);border:0}.info-card,.card{background:linear-gradient(180deg,rgba(255,255,255,.085),rgba(255,255,255,.035));border:1px solid var(--line);border-radius:var(--radius);padding:22px}.recommended{border-left:4px solid var(--accent)}.warning{border-left:4px solid var(--warm)}.danger{border-left:4px solid var(--bad)}.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px}.metric{background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:15px;padding:14px}.metric strong{display:block;font-size:24px}.table{width:100%;border-collapse:collapse;margin:12px 0 28px}.table th,.table td{padding:12px 13px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}.table th{background:rgba(255,255,255,.08)}.small{font-size:14px;color:var(--muted)}code{background:rgba(255,255,255,.08);border:1px solid var(--line);border-radius:7px;padding:2px 6px;color:#d8fff2}.footer{border-top:1px solid var(--line);color:var(--muted);padding:32px;text-align:center}.tag,.score{display:inline-block;border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:4px 10px;font-size:12px;color:#d8edf8;background:rgba(255,255,255,.06);margin-bottom:8px}.score{color:#d8fff2;background:rgba(40,211,154,.08);border-color:rgba(40,211,154,.22)}.flow{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.flow div{border:1px solid var(--line);border-radius:16px;padding:14px;background:rgba(255,255,255,.05)}ul{margin-top:8px}li{color:var(--muted);margin-bottom:5px}.callout{padding:18px;border-radius:18px;border:1px solid rgba(255,255,255,.16);background:rgba(0,160,160,.10)}
@media(max-width:1100px){.hero,.grid-4,.grid-3,.grid-2,.flow{grid-template-columns:1fr}.nav-links{display:none}.table{font-size:14px}}
